# ==============================================================================
# PayVia Environment Configuration Template
# Copy this file to .env.local (or secrets.txt) and populate your credentials.
# All private keys must remain server-only. Never prefix secrets with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE REQUIRED CREDENTIALS (Local Dev & Production)
# ------------------------------------------------------------------------------

# PayPal Sandbox REST API Credentials (Developer Dashboard -> Apps & Credentials)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MERCHANT_EMAIL=your_paypal_business_sandbox_email
PAYPAL_ENVIRONMENT=sandbox

# Google Gemini AI API Key (Google AI Studio -> Get API key)
# Used for autonomous Buyer & Merchant negotiation agents
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key

# Public Application URL (Base URL for PayPal redirect callbacks and webhooks)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PERSISTENT STORAGE / DATABASE (MANDATORY in Production, Optional in Local Dev)
# ------------------------------------------------------------------------------

# PostgreSQL Connection String (Prisma ORM)
# Production runtime enforces this connection and fails closed if omitted.
# In local development (NODE_ENV=development), in-memory fallback is used if omitted.
DATABASE_URL=postgresql://postgres:password@localhost:5432/payvia?schema=public

# ------------------------------------------------------------------------------
# 3. OPTIONAL INTEGRATIONS (Graceful non-blocking fallbacks if omitted)
# ------------------------------------------------------------------------------

# Channel3 Live Product Discovery API
# Optional: If omitted, PayVia falls back to the curated demo catalog.
CHANNEL3_API_KEY=your_channel3_api_key_here

# Elasticsearch Serverless AI Memory Layer
# Optional: If omitted or unreachable, PayVia falls back to in-memory semantic memory.
ELASTICSEARCH_URL=https://your-serverless-endpoint.es.io:443
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key

# PayPal Webhook ID (Optional for local testing; simulated if unconfigured)
PAYPAL_WEBHOOK_ID=WH-PAYVIA-SANDBOX-DEFAULT
